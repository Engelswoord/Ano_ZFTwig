<phpunit bootstrap="./tests/Bootstrap.php" colors="true" cacheDirectory=".phpunit.cache">
    <testsuite name="Zend Framework Test Suite">
        <directory>./tests/</directory>
    </testsuite>

    <groups>
        <exclude>
            <group>disable</group>
        </exclude>
    </groups>

    <source>
        <include>
            <directory suffix=".php">./library/</directory>
        </include>
    </source>
</phpunit>
